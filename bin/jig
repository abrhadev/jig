#!/usr/bin/env bash
set -euo pipefail

JIG_VERSION="0.1.0"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

if [ ! -t 1 ]; then
    RED=""; GREEN=""; YELLOW=""; BOLD=""; DIM=""; NC=""
fi

info() { printf '%s[jig]%s %s\n' "$GREEN" "$NC" "$1"; }
warn() { printf '%s[jig]%s %s\n' "$YELLOW" "$NC" "$1" >&2; }
fail() { printf '%s[jig]%s %s\n' "$RED" "$NC" "$1" >&2; }
hint() { printf '%s       %s%s\n' "$DIM" "$1" "$NC" >&2; }

abort() {
    fail "$1"
    shift
    for line in "$@"; do hint "$line"; done
    exit 1
}

load_jig_env() {
    local file="$1/jig.env" line key
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in
            ''|'#'*) continue ;;
        esac
        key="${line%%=*}"
        key="${key%"${key##*[![:space:]]}"}"
        key="${key#"${key%%[![:space:]]*}"}"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        if [ -z "${!key+x}" ]; then
            export "${line?}"
        fi
    done < "$file"
}

label_of() {
    docker inspect -f "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null || true
}

resolve_package_root() {
    local source="${BASH_SOURCE[0]}" dir

    while [ -L "$source" ]; do
        dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [ "${source:0:1}" = "/" ] || source="$dir/$source"
    done

    dir="$(cd -P "$(dirname "$source")" && pwd)"

    dirname "$dir"
}

find_project_root() {
    local dir="$PWD"

    while [ "$dir" != "/" ]; do
        if [ -f "$dir/composer.json" ] && [ "$dir" != "$JIG_PACKAGE_ROOT" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    return 1
}

jig_ssh_enabled() {
    local value="${JIG_SSH:-}"
    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"

    case "$value" in
        1|true|yes) return 0 ;;
        *) return 1 ;;
    esac
}

ssh_mode() {
    if ! jig_ssh_enabled; then
        printf 'none\n'
        return 0
    fi

    if [ -n "${JIG_SSH_AUTH_SOCK:-}" ] && [ -S "$JIG_SSH_AUTH_SOCK" ]; then
        printf 'agent\n'
        return 0
    fi

    if [ -n "${JIG_SSH_DIR:-}" ] && [ -d "$JIG_SSH_DIR" ]; then
        printf 'dir\n'
        return 0
    fi

    printf 'missing\n'
}

abort_missing_ssh() {
    abort "JIG_SSH is enabled but no SSH agent or JIG_SSH_DIR is available." \
        "Load a key into an agent (ssh-add), then retry. Run 'jig restart' if the container is already up." \
        "Or set JIG_SSH_DIR to a directory of keys (that directory is copied into the container)."
}

JIG_PACKAGE_ROOT="$(resolve_package_root)"

if ! JIG_PROJECT_ROOT="$(find_project_root)"; then
    abort "No composer.json found in $PWD or any parent directory." \
        "Run jig from inside the package you want to work on."
fi

JIG_PROJECT_NAME="jig-$(basename "$JIG_PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')"
JIG_PROJECT_NAME="${JIG_PROJECT_NAME%%-}"

load_jig_env "$JIG_PROJECT_ROOT"

JIG_PHP_VERSION="${JIG_PHP_VERSION:-8.4}"
JIG_UID="${JIG_UID:-$(id -u)}"
JIG_GID="${JIG_GID:-$(id -g)}"
JIG_IMAGE="${JIG_IMAGE:-abrha/jig:$JIG_PHP_VERSION}"
JIG_COMPOSER_CACHE="${JIG_COMPOSER_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/abrha-jig/composer}"
JIG_SSH="${JIG_SSH:-}"
JIG_SSH_DIR="${JIG_SSH_DIR:-}"
JIG_PHPSTAN_MEMORY="${JIG_PHPSTAN_MEMORY:-512M}"
JIG_MIN_LINE="${JIG_MIN_LINE:-}"
JIG_MIN_METHOD="${JIG_MIN_METHOD:-}"
JIG_MIN_CLASS="${JIG_MIN_CLASS:-}"
JIG_QUALITY_MIN_LINE="${JIG_QUALITY_MIN_LINE:-80}"
JIG_QUALITY_MIN_METHOD="${JIG_QUALITY_MIN_METHOD:-80}"
JIG_QUALITY_MIN_CLASS="${JIG_QUALITY_MIN_CLASS:-}"
JIG_TEST_TOOL="${JIG_TEST_TOOL:-}"
JIG_STYLE_TOOL="${JIG_STYLE_TOOL:-}"
JIG_ANALYSIS_TOOL="${JIG_ANALYSIS_TOOL:-}"

if [ -d "$JIG_PROJECT_ROOT/docker/jig" ]; then
    JIG_ARTIFACT_DIR="$JIG_PROJECT_ROOT/docker/jig"
    JIG_ARTIFACTS_PUBLISHED=true
else
    JIG_ARTIFACT_DIR="$JIG_PACKAGE_ROOT/runtimes"
    JIG_ARTIFACTS_PUBLISHED=false
fi

JIG_RUNTIME_PATH="$JIG_ARTIFACT_DIR/php"
JIG_SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}"

export JIG_COMPOSER_CACHE JIG_GID JIG_IMAGE JIG_PHP_VERSION JIG_PROJECT_NAME \
    JIG_PROJECT_ROOT JIG_RUNTIME_PATH JIG_SSH_AUTH_SOCK JIG_SSH_DIR JIG_UID

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        abort "Docker is not installed or not on PATH." \
            "jig needs nothing else, but it does need Docker."
    fi

    local docker_info_err
    if ! docker_info_err="$(docker info 2>&1 >/dev/null)"; then
        printf '%s\n' "$docker_info_err" >&2
        abort "Docker is installed but the daemon is not reachable." \
            "Start Docker Desktop, or run: sudo service docker start"
    fi
}

compose_file_args() {
    local strict="${1:-strict}"
    local files=(-f "$JIG_ARTIFACT_DIR/docker-compose.yml")
    local mode
    mode="$(ssh_mode)"

    case "$mode" in
        agent) files+=(-f "$JIG_ARTIFACT_DIR/docker-compose.ssh-agent.yml") ;;
        dir) files+=(-f "$JIG_ARTIFACT_DIR/docker-compose.ssh-dir.yml") ;;
        missing)
            if [ "$strict" = strict ]; then
                abort_missing_ssh
            fi
            ;;
    esac

    printf '%s\n' "${files[@]}"
}

dc() {
    local strict=strict
    if [ "${1:-}" = --lax ]; then
        strict=lax
        shift
    fi

    local files=()
    while IFS= read -r line; do files+=("$line"); done < <(compose_file_args "$strict")

    docker compose "${files[@]}" -p "$JIG_PROJECT_NAME" "$@"
}

container_id() {
    dc --lax ps -q php 2>/dev/null || true
}

is_running() {
    local id
    id="$(container_id)"

    [ -n "$id" ] || return 1
    [ "$(docker inspect -f '{{.State.Running}}' "$id" 2>/dev/null || echo false)" = "true" ]
}

running_image() {
    local id
    id="$(container_id)"

    [ -n "$id" ] || return 1
    docker inspect -f '{{.Config.Image}}' "$id" 2>/dev/null
}

prepare_host_paths() {
    mkdir -p "$JIG_COMPOSER_CACHE"
}

ensure_up() {
    require_docker
    prepare_host_paths

    if is_running && [ "$(running_image)" = "$JIG_IMAGE" ]; then
        return 0
    fi

    if is_running; then
        info "Recreating container..."
        dc up -d --remove-orphans --force-recreate
        return 0
    fi

    if ! docker image inspect "$JIG_IMAGE" >/dev/null 2>&1; then
        info "Building $JIG_IMAGE..."
        dc build
    fi

    info "Starting container..."
    dc up -d --remove-orphans
}

ensure_dependencies() {
    if [ -f "$JIG_PROJECT_ROOT/vendor/.jig-bootstrap" ]; then
        info "Running Composer scripts inside the container..."
        exec_in_container composer install --prefer-dist --no-progress
        rm -f "$JIG_PROJECT_ROOT/vendor/.jig-bootstrap"
        return 0
    fi

    if [ ! -f "$JIG_PROJECT_ROOT/vendor/autoload.php" ]; then
        info "Installing Composer dependencies..."
        exec_in_container composer install --prefer-dist --no-progress
    fi
}

exec_in_container() {
    local flags=()

    [ -t 0 ] || flags+=(-T)

    dc exec "${flags[@]}" php "$@"
}

ready() {
    ensure_up
    ensure_dependencies
}

resolve_tool() {
    local axis="$1" configured="$2"
    shift 2

    if [ -n "$configured" ]; then
        for candidate in "$@"; do
            if [ "$configured" = "$candidate" ]; then
                if [ -x "$JIG_PROJECT_ROOT/vendor/bin/$candidate" ]; then
                    printf '%s\n' "$candidate"
                    return 0
                fi

                abort "Configured $axis tool '$configured' is not installed." \
                    "Expected vendor/bin/$configured. Run 'jig install' or update jig.env."
            fi
        done

        abort "Unsupported $axis tool '$configured'." \
            "Supported tools: $*"
    fi

    local found=() candidate

    for candidate in "$@"; do
        if [ -x "$JIG_PROJECT_ROOT/vendor/bin/$candidate" ]; then
            found+=("$candidate")
        fi
    done

    if [ "${#found[@]}" -eq 0 ]; then
        abort "No supported $axis tool is installed." \
            "Supported tools: $*" \
            "Install one or select it explicitly in jig.env."
    fi

    if [ "${#found[@]}" -gt 1 ]; then
        abort "Multiple $axis tools are installed: ${found[*]}." \
            "Select one explicitly in jig.env."
    fi

    printf '%s\n' "${found[0]}"
}

test_tool() {
    resolve_tool "test" "$JIG_TEST_TOOL" pest phpunit
}

style_tool() {
    resolve_tool "style" "$JIG_STYLE_TOOL" pint php-cs-fixer
}

analysis_tool() {
    resolve_tool "analysis" "$JIG_ANALYSIS_TOOL" phpstan psalm
}

metric_from() {
    awk -v key="$1" '
        index($0, key ":") && match($0, /[0-9]+(\.[0-9]+)?%/) {
            print substr($0, RSTART, RLENGTH - 1)
            exit
        }
    ' "$2"
}

at_least() {
    awk -v actual="$1" -v required="$2" 'BEGIN { exit !(actual + 0 >= required + 0) }'
}

apply_min_flag() {
    local -n _min_line="$1" _min_method="$2" _min_class="$3"
    local arg="$4"

    case "$arg" in
        --min-line=*)   _min_line="${arg#*=}" ;;
        --min-method=*) _min_method="${arg#*=}" ;;
        --min-class=*)  _min_class="${arg#*=}" ;;
        *) return 1 ;;
    esac
}

report_thresholds() {
    local file="$1" min_line="$2" min_method="$3" min_class="$4"
    local failed=0 label metric minimum

    if [ -z "$min_line$min_method$min_class" ]; then
        return 0
    fi

    if [ ! -f "$file" ]; then
        abort "Coverage report '$file' was not produced." \
            "Check the test output above for the real failure."
    fi

    printf '\n%sCoverage thresholds%s\n' "$BOLD" "$NC"

    for pair in "Classes:$min_class" "Methods:$min_method" "Lines:$min_line"; do
        label="${pair%%:*}"
        minimum="${pair#*:}"

        [ -n "$minimum" ] || continue

        metric="$(metric_from "$label" "$file")"

        if [ -z "$metric" ]; then
            abort "Could not read '$label' coverage from $file." \
                "The report format may have changed; inspect the file directly."
        fi

        if at_least "$metric" "$minimum"; then
            printf '  %-9s %7s%%  (min %s%%)  %sPASS%s\n' "$label" "$metric" "$minimum" "$GREEN" "$NC"
        else
            printf '  %-9s %7s%%  (min %s%%)  %sFAIL%s\n' "$label" "$metric" "$minimum" "$RED" "$NC"
            failed=1
        fi
    done

    printf '\n'

    return "$failed"
}

cmd_build() {
    require_docker
    prepare_host_paths
    info "Building $JIG_IMAGE..."
    dc --lax build "$@"
}

cmd_up() {
    ensure_up
    info "Container is running. Try 'jig pest' or 'jig help'."
}

cmd_down() {
    require_docker
    info "Stopping container..."
    dc --lax down "$@"
}

cmd_restart() {
    require_docker
    info "Restarting container..."
    dc --lax restart
}

cmd_logs() {
    require_docker
    dc --lax logs -f php
}

cmd_status() {
    require_docker
    dc --lax ps
}

cmd_reset() {
    require_docker
    prepare_host_paths
    warn "Rebuilding the development environment from scratch."
    dc --lax down -v --remove-orphans
    dc --lax build --no-cache
    dc up -d --remove-orphans
    exec_in_container composer install --prefer-dist --no-progress
    rm -f "$JIG_PROJECT_ROOT/vendor/.jig-bootstrap"
    info "Reset complete."
}

cmd_install() {
    ensure_up
    info "Installing Composer dependencies..."
    exec_in_container composer install --prefer-dist --no-progress "$@"
    rm -f "$JIG_PROJECT_ROOT/vendor/.jig-bootstrap"
}

cmd_update() {
    ensure_up
    info "Updating Composer dependencies..."
    exec_in_container composer update --prefer-dist --no-progress "$@"
    rm -f "$JIG_PROJECT_ROOT/vendor/.jig-bootstrap"
}

cmd_pest() {
    ready
    exec_in_container pest "$@"
}

cmd_phpunit() {
    ready
    exec_in_container phpunit "$@"
}

cmd_test() {
    ready
    exec_in_container "$(test_tool)" "$@"
}

cmd_pint() {
    ready
    exec_in_container pint "$@"
}

cmd_php_cs_fixer() {
    ready
    exec_in_container php-cs-fixer "$@"
}

cmd_phpstan() {
    ready

    local has_memory_limit=false

    for arg in "$@"; do
        case "$arg" in
            --memory-limit=*) has_memory_limit=true ;;
        esac
    done

    if [ "$has_memory_limit" = true ]; then
        exec_in_container phpstan analyse "$@"
    else
        exec_in_container phpstan analyse --memory-limit="$JIG_PHPSTAN_MEMORY" "$@"
    fi
}

cmd_psalm() {
    ready
    exec_in_container psalm "$@"
}

cmd_analyse() {
    ready

    if [ "$(analysis_tool)" = phpstan ]; then
        cmd_phpstan "$@"
    else
        cmd_psalm "$@"
    fi
}

cmd_coverage() {
    local min_line="$JIG_MIN_LINE" min_method="$JIG_MIN_METHOD" min_class="$JIG_MIN_CLASS"
    local html=false passthrough=() runner

    for arg in "$@"; do
        apply_min_flag min_line min_method min_class "$arg" && continue

        case "$arg" in
            --html) html=true ;;
            *)      passthrough+=("$arg") ;;
        esac
    done

    ready

    runner="$(test_tool)"
    local args=(--coverage-text=coverage.txt)

    if [ "$html" = true ]; then
        args+=(--coverage-html=build/coverage)
    fi

    if [ "$runner" = pest ]; then
        args+=(--only-summary-for-coverage-text)
    fi

    exec_in_container "$runner" "${args[@]}" ${passthrough[@]+"${passthrough[@]}"}

    printf '\n'
    cat "$JIG_PROJECT_ROOT/coverage.txt"

    if [ "$html" = true ]; then
        info "HTML report written to build/coverage/index.html"
    fi

    report_thresholds "$JIG_PROJECT_ROOT/coverage.txt" "$min_line" "$min_method" "$min_class"
}

cmd_quality() {
    local min_line="$JIG_QUALITY_MIN_LINE"
    local min_method="$JIG_QUALITY_MIN_METHOD"
    local min_class="$JIG_QUALITY_MIN_CLASS"
    local memory_limit="$JIG_PHPSTAN_MEMORY"
    local skip_style=false skip_analysis=false skip_tests=false
    local failures=() selected_style selected_analysis selected_test

    for arg in "$@"; do
        apply_min_flag min_line min_method min_class "$arg" && continue

        case "$arg" in
            --memory-limit=*) memory_limit="${arg#*=}" ;;
            --skip-style|--skip-pint)       skip_style=true ;;
            --skip-analysis|--skip-phpstan) skip_analysis=true ;;
            --skip-tests)     skip_tests=true ;;
            *) abort "Unknown option for 'quality': $arg" "Run 'jig help' for the supported options." ;;
        esac
    done

    ready

    if [ "$skip_style" != true ]; then
        selected_style="$(style_tool)"
        printf '\n%s1. Code style%s\n' "$BOLD" "$NC"
        if [ "$selected_style" = pint ]; then
            exec_in_container pint --test || failures+=("code style")
        else
            exec_in_container php-cs-fixer fix --dry-run --diff || failures+=("code style")
        fi
    fi

    if [ "$skip_analysis" != true ]; then
        selected_analysis="$(analysis_tool)"
        printf '\n%s2. Static analysis%s\n' "$BOLD" "$NC"
        if [ "$selected_analysis" = phpstan ]; then
            exec_in_container phpstan analyse --memory-limit="$memory_limit" || failures+=("static analysis")
        else
            exec_in_container psalm || failures+=("static analysis")
        fi
    fi

    if [ "$skip_tests" != true ]; then
        selected_test="$(test_tool)"
        printf '\n%s3. Tests and coverage%s\n' "$BOLD" "$NC"

        local test_args=(--coverage-text=coverage.txt)
        if [ "$selected_test" = pest ]; then
            test_args+=(--only-summary-for-coverage-text)
        fi

        if exec_in_container "$selected_test" "${test_args[@]}"; then
            printf '\n'
            cat "$JIG_PROJECT_ROOT/coverage.txt"
            report_thresholds "$JIG_PROJECT_ROOT/coverage.txt" "$min_line" "$min_method" "$min_class" \
                || failures+=("coverage thresholds")
        else
            failures+=("tests")
        fi
    fi

    if [ "${#failures[@]}" -eq 0 ]; then
        info "All quality checks passed."
        return 0
    fi

    fail "Quality checks failed: ${failures[*]}"

    return 1
}

cmd_shell() {
    ready
    dc exec -e PS1='jig:\w\$ ' php bash
}

cmd_publish() {
    local force=false

    for arg in "$@"; do
        case "$arg" in
            --force) force=true ;;
            *) abort "Unknown option for 'publish': $arg" ;;
        esac
    done

    local target="$JIG_PROJECT_ROOT/docker/jig"

    if [ -d "$target" ] && [ "$force" != true ]; then
        abort "$target already exists." "Pass --force to overwrite it."
    fi

    mkdir -p "$target"
    cp -R "$JIG_PACKAGE_ROOT/runtimes/." "$target/"

    info "Published runtime artifacts to docker/jig/."
    hint "jig now uses docker/jig/. Run 'jig build' to rebuild the image."
}

cmd_stub() {
    local force=false

    for arg in "$@"; do
        case "$arg" in
            --force) force=true ;;
            *) abort "Unknown option for 'stub': $arg" ;;
        esac
    done

    local shim="$JIG_PROJECT_ROOT/jig"
    local env_file="$JIG_PROJECT_ROOT/jig.env.example"

    if [ -f "$shim" ] && [ "$force" != true ]; then
        abort "$shim already exists." "Pass --force to overwrite it."
    fi

    cp "$JIG_PACKAGE_ROOT/stubs/jig" "$shim"
    chmod +x "$shim"

    if [ -f "$env_file" ] && [ "$force" != true ]; then
        info "Wrote ./jig. jig.env.example already exists."
        return 0
    fi

    cp "$JIG_PACKAGE_ROOT/stubs/jig.env.example" "$env_file"
    info "Wrote ./jig and jig.env.example."
}

cmd_doctor() {
    local problems=0 image_uid="" image_gid="" mode

    printf '%sEnvironment%s\n' "$BOLD" "$NC"

    if command -v docker >/dev/null 2>&1; then
        printf '  docker            %sfound%s (%s)\n' "$GREEN" "$NC" "$(docker --version | head -n1)"
    else
        printf '  docker            %smissing%s\n' "$RED" "$NC"
        problems=$((problems + 1))
    fi

    if docker info >/dev/null 2>&1; then
        printf '  docker daemon     %srunning%s\n' "$GREEN" "$NC"
    else
        printf '  docker daemon     %sunreachable%s\n' "$RED" "$NC"
        problems=$((problems + 1))
    fi

    printf '\n%sProject%s\n' "$BOLD" "$NC"
    printf '  root              %s\n' "$JIG_PROJECT_ROOT"
    printf '  compose project   %s\n' "$JIG_PROJECT_NAME"
    printf '  artifacts         %s%s\n' "$JIG_ARTIFACT_DIR" \
        "$([ "$JIG_ARTIFACTS_PUBLISHED" = true ] && echo ' (published)' || echo ' (vendored)')"
    printf '  image             %s\n' "$JIG_IMAGE"
    printf '  host uid:gid      %s:%s\n' "$JIG_UID" "$JIG_GID"
    printf '  composer cache    %s\n' "$JIG_COMPOSER_CACHE"
    if [ -f "$JIG_PROJECT_ROOT/jig.env.example" ]; then
        printf '  jig.env.example   %sfound%s\n' "$GREEN" "$NC"
    else
        printf '  jig.env.example   %smissing%s — run: jig stub\n' "$YELLOW" "$NC"
    fi
    if [ -f "$JIG_PROJECT_ROOT/jig.env" ]; then
        printf '  jig.env           %sfound%s\n' "$GREEN" "$NC"
    else
        printf '  jig.env           %snot set%s (using built-in defaults)\n' "$DIM" "$NC"
    fi

    printf '\n%sState%s\n' "$BOLD" "$NC"

    if docker image inspect "$JIG_IMAGE" >/dev/null 2>&1; then
        image_uid="$(label_of "$JIG_IMAGE" "com.abrha.jig.uid")"
        image_gid="$(label_of "$JIG_IMAGE" "com.abrha.jig.gid")"
        printf '  image            %sbuilt%s (uid %s:%s)\n' "$GREEN" "$NC" "$image_uid" "$image_gid"
        if [ "$image_uid" != "$JIG_UID" ] || [ "$image_gid" != "$JIG_GID" ]; then
            hint "Image uid:gid differs from host ($JIG_UID:$JIG_GID). Run 'jig build' if files are owned incorrectly."
        fi
    else
        printf '  image            %snot built%s — run: jig build\n' "$YELLOW" "$NC"
    fi

    if is_running; then
        printf '  container        %srunning%s\n' "$GREEN" "$NC"
    else
        printf '  container        %sstopped%s — run: jig up\n' "$YELLOW" "$NC"
    fi

    if [ -f "$JIG_PROJECT_ROOT/vendor/autoload.php" ]; then
        printf '  dependencies     %sinstalled%s\n' "$GREEN" "$NC"
    else
        printf '  dependencies     %smissing%s — run: jig install\n' "$YELLOW" "$NC"
    fi

    printf '\n%sSSH (private Composer repositories)%s\n' "$BOLD" "$NC"

    mode="$(ssh_mode)"

    case "$mode" in
        none)
            printf '  ssh              %sdisabled%s — Packagist/HTTPS only. Set JIG_SSH=1 for private Git.\n' "$DIM" "$NC"
            ;;
        agent)
            printf '  ssh              %senabled%s (agent forwarded)\n' "$GREEN" "$NC"
            ;;
        dir)
            printf '  ssh              %senabled%s (keys from %s; copied into the container)\n' \
                "$GREEN" "$NC" "$JIG_SSH_DIR"
            if [ -f "$JIG_SSH_DIR/known_hosts" ]; then
                printf '  known_hosts      %sfound%s\n' "$GREEN" "$NC"
            else
                printf '  known_hosts      %smissing%s — host keys will be accepted on first use\n' "$YELLOW" "$NC"
            fi
            ;;
        missing)
            printf '  ssh              %senabled but unused%s — no agent socket and JIG_SSH_DIR is not a directory\n' \
                "$RED" "$NC"
            problems=$((problems + 1))
            ;;
    esac

    printf '\n'

    if [ "$problems" -gt 0 ]; then
        fail "$problems problem(s) need attention."
        return 1
    fi

    info "No problems detected."
}

cmd_help() {
    cat <<HELP
${BOLD}abrha/jig${NC} ${DIM}${JIG_VERSION}${NC} — Docker-based development environment

${BOLD}Usage${NC}
  jig <command> [options]

${BOLD}Getting started${NC}
  ./jig pest

${BOLD}Testing${NC}
  test [args]              Run the detected test tool
  pest [args]              Run Pest explicitly
  phpunit [args]           Run PHPUnit explicitly
  coverage [options]       Run tests and report coverage
                             --min-line=N --min-method=N --min-class=N
                             --html   also write build/coverage/

${BOLD}Quality${NC}
  pint [args]              Run Pint explicitly
  php-cs-fixer [args]      Run PHP CS Fixer explicitly
  analyse [args]           Run the detected analysis tool
  phpstan [args]           Run PHPStan explicitly
  psalm [args]             Run Psalm explicitly
  quality [options]        Run style, analysis and coverage
                             --min-line=N --min-method=N --min-class=N
                             --memory-limit=SIZE
                             --skip-style --skip-analysis --skip-tests

${BOLD}Dependencies${NC}
  install [args]           composer install
  update [args]            composer update
  composer <args>          Any composer command

${BOLD}Container${NC}
  up                       Start the container
  down [-v]                Stop the container
  restart                  Restart the container
  build [--no-cache]       Rebuild the image
  logs                     Follow container logs
  status                   Show container status
  reset                    Rebuild everything from scratch and reinstall

${BOLD}Utilities${NC}
  shell                    Interactive shell in the container
  php <args>               Run PHP
  bin <tool> [args]        Run any vendor/bin tool
  doctor                   Diagnose the local setup
  publish [--force]        Copy Dockerfile and compose files into docker/jig/
  stub [--force]           Write ./jig and jig.env.example into this package
  version                  Print the jig version
  help                     Show this message

${BOLD}Configuration${NC}
  Built-in defaults apply unless ${BOLD}jig.env${NC} exists (copy from jig.env.example).
  Environment variables already set in the shell take precedence.

      JIG_PHP_VERSION=8.2 ./jig pest
      JIG_TEST_TOOL=phpunit JIG_STYLE_TOOL=php-cs-fixer JIG_ANALYSIS_TOOL=psalm ./jig quality

${BOLD}Anything else${NC}
  Unrecognised commands are run from vendor/bin when present.
HELP
}

command="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command" in
    build)              cmd_build "$@" ;;
    up)                 cmd_up "$@" ;;
    down)               cmd_down "$@" ;;
    restart)            cmd_restart "$@" ;;
    logs)               cmd_logs "$@" ;;
    status|ps)          cmd_status "$@" ;;
    reset)              cmd_reset "$@" ;;

    install)            cmd_install "$@" ;;
    update)             cmd_update "$@" ;;
    composer)           ensure_up; exec_in_container composer "$@" ;;

    test)               cmd_test "$@" ;;
    pest)               cmd_pest "$@" ;;
    phpunit)            cmd_phpunit "$@" ;;
    coverage)           cmd_coverage "$@" ;;

    pint)               cmd_pint "$@" ;;
    php-cs-fixer)       cmd_php_cs_fixer "$@" ;;
    analyse|analyze)    cmd_analyse "$@" ;;
    phpstan)            cmd_phpstan "$@" ;;
    psalm)              cmd_psalm "$@" ;;
    quality)            cmd_quality "$@" ;;

    shell|sh|bash)      cmd_shell "$@" ;;
    php)                ready; exec_in_container php "$@" ;;
    bin)
        [ "$#" -gt 0 ] || abort "Usage: jig bin <tool> [args]"
        tool="$1"; shift
        ready
        exec_in_container "$tool" "$@"
        ;;

    doctor)             cmd_doctor "$@" ;;
    publish)            cmd_publish "$@" ;;
    stub)               cmd_stub "$@" ;;
    version|--version|-V) printf 'abrha/jig %s\n' "$JIG_VERSION" ;;
    help|--help|-h)     cmd_help ;;

    *)
        if [ -x "$JIG_PROJECT_ROOT/vendor/bin/$command" ]; then
            ready
            exec_in_container "$command" "$@"
        else
            abort "Unknown command: $command" \
                "It is not a jig command and vendor/bin/$command does not exist." \
                "Run 'jig help' to see what is available."
        fi
        ;;
esac
