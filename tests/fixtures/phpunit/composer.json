{
    "name": "abrha/jig-phpunit-fixture",
    "type": "project",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "abrha/jig": "@dev",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Fixture\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
